// #include "BluetoothA2DPSource.h"
#include "BluetoothA2DPSink.h"
#include "ESP_I2S.h"
// #include <AudioTools.h>
#include <Arduino.h>
#include <Preferences.h>

#include <FastLED.h>
#include <arduinoFFT.h>

const uint8_t I2S_SCK = 25;   /* Audio data bit clock */
const uint8_t I2S_WS = 27;    /* Audio data left and right clock */
const uint8_t I2S_SDOUT = 26; /* ESP32 audio data output (to speakers) */

const uint8_t LED_PIN = 12; // WS2812B 数据引脚

// ---- LED 矩阵参数 ----
#define NUM_COLS 32
#define NUM_ROWS 8
#define NUM_LEDS (NUM_COLS * NUM_ROWS) // 256

CRGB leds[NUM_LEDS];

// ---- FFT 参数 ----
#define SAMPLES 512         // FFT 点数（必须为 2 的幂）
#define SAMPLING_FREQ 44100 // 音频采样率（由蓝牙协商，此处固定）
#define FFT_FLOAT float
ArduinoFFT<FFT_FLOAT> FFT;

FFT_FLOAT vReal[SAMPLES]; // FFT 实部
FFT_FLOAT vImag[SAMPLES]; // FFT 虚部（初始化为 0）
int sampleIndex = 0;   // 当前已采集的样本数

// ---- 音频数据环形缓冲区 ----
#define AUDIO_BUF_SIZE (SAMPLES * 2) // 存储 int16_t 单声道样本
int16_t audioBuf[AUDIO_BUF_SIZE];
volatile int bufWritePos = 0;
volatile int bufReadPos = 0;

I2SClass i2s;
BluetoothA2DPSink a2dp_sink(i2s);
Preferences prefs;

esp_a2d_connection_state_t last_state;
uint16_t minutes = 5;
unsigned long shutdown_ms = millis() + 1000 * 60 * minutes;

// move shutdown time to future
void on_data()
{
    shutdown_ms = millis() + 1000 * 60 * minutes;
}

//! ★ 音量变更回调（手机/PC 调音量时触发）
void on_volume_change(int volume)
{
    // volume 范围一般是 0–127（AVRC 绝对音量），存起来
    prefs.putUChar("vol", (uint8_t)volume);
    printf("Volume changed: %d, saved to NVS\r\n", volume);
}

// Then somewhere in your sketch:
void read_data_stream(const uint8_t *data, uint32_t length)
{
    // 将立体声音频转为单声道，存入环形缓冲区
    int16_t *samples = (int16_t *)data;
    uint32_t numFrames = length / 4; // 每帧 4 字节（左+右）

    for (uint32_t i = 0; i < numFrames; i++)
    {
        int16_t left = samples[i * 2];
        int16_t right = samples[i * 2 + 1];
        int16_t mono = (left + right) / 2; // 混合为单声道

        // 写入环形缓冲区
        int nextPos = (bufWritePos + 1) % AUDIO_BUF_SIZE;
        if (nextPos != bufReadPos)
        { // 未满则写入
            audioBuf[bufWritePos] = mono;
            bufWritePos = nextPos;
        }
        else
        {
            // 缓冲区满，丢弃旧数据（读指针追写指针）
            bufReadPos = (bufReadPos + 1) % AUDIO_BUF_SIZE;
            audioBuf[bufWritePos] = mono;
            bufWritePos = nextPos;
        }
    }
}

void avrc_metadata_callback(uint8_t id, const uint8_t *text)
{
    printf("==> AVRC metadata rsp: attribute id 0x%x, %s\n", id, text);
    if (id == ESP_AVRC_MD_ATTR_PLAYING_TIME)
    {
        uint32_t playtime = String((char *)text).toInt();
        printf("==> Playing time is %d ms (%d seconds)\n", playtime, (int)round(playtime / 1000.0));
    }
}

// ========================
// FFT 处理与 LED 更新
// ========================
void performFFTAndUpdateLEDs()
{
    // 从环形缓冲区取出 SAMPLES 个样本
    int available = (bufWritePos - bufReadPos + AUDIO_BUF_SIZE) % AUDIO_BUF_SIZE;
    if (available < SAMPLES)
        return; // 数据不足，跳过本次更新

    for (int i = 0; i < SAMPLES; i++)
    {
        vReal[i] = (FFT_FLOAT)audioBuf[bufReadPos];
        vImag[i] = 0.0;
        bufReadPos = (bufReadPos + 1) % AUDIO_BUF_SIZE;
    }

    // 执行 FFT
    FFT.windowing(vReal, SAMPLES, FFT_WIN_TYP_HAMMING, FFT_FORWARD);
    FFT.compute(vReal, vImag, SAMPLES, FFT_FORWARD);
    FFT.complexToMagnitude(vReal, vImag, SAMPLES);

    // 计算每个 bin 的幅度，映射到 32 列
    // 只使用前一半频谱（0~SAMPLES/2），因为实信号对称
    FFT_FLOAT maxMag = 1.0; // 防止除以零
    for (int i = 0; i < SAMPLES / 2; i++)
    {
        if (vReal[i] > maxMag)
            maxMag = vReal[i];
    }
    if (maxMag < 1.0)
        maxMag = 1.0;

    // 将频谱分成 32 个 band（每个 band 包含 SAMPLES/2/32 = 8 个 bin）
    int binsPerBand = (SAMPLES / 2) / NUM_COLS;
    if (binsPerBand < 1)
        binsPerBand = 1;

    for (int col = 0; col < NUM_COLS; col++)
    {
        double sum = 0.0;
        int startBin = col * binsPerBand;
        int endBin = startBin + binsPerBand;
        if (endBin > SAMPLES / 2)
            endBin = SAMPLES / 2;
        for (int b = startBin; b < endBin; b++)
        {
            sum += vReal[b];
        }
        double avg = sum / binsPerBand;
        // 归一化到 0~1
        double normalized = avg / maxMag;
        // 对数缩放，使低频更突出
        double scaled = log10(1.0 + 9.0 * normalized);
        // 映射到 0~NUM_ROWS
        int height = (int)(scaled * NUM_ROWS);
        if (height > NUM_ROWS)
            height = NUM_ROWS;
        if (height < 0)
            height = 0;

        // 填充该列的 LED
        for (int row = 0; row < NUM_ROWS; row++)
        {
            int ledIndex = row * NUM_COLS + col; // 行优先
            if (row < height)
            {
                // 根据高度设置颜色渐变（底部红色，顶部蓝色）
                uint8_t hue = map(row, 0, NUM_ROWS - 1, 0, 160); // 红->青
                leds[ledIndex] = CHSV(hue, 255, 150);            // 饱和度全开，亮度 150
            }
            else
            {
                leds[ledIndex] = CRGB::Black;
            }
        }
    }

    FastLED.show();
}

void setup()
{
    // ---- 初始化 WS2812B ----
    FastLED.addLeds<WS2812B, LED_PIN, GRB>(leds, NUM_LEDS);
    FastLED.setBrightness(50); // 全局亮度（0-255）
    FastLED.clear();
    FastLED.show();

    i2s.setPins(I2S_SCK, I2S_WS, I2S_SDOUT);
    if (!i2s.begin(I2S_MODE_STD, 44100, I2S_DATA_BIT_WIDTH_16BIT,
                   I2S_SLOT_MODE_STEREO, I2S_STD_SLOT_BOTH))
    {
        printf("Failed to initialize I2S!\r\n");
        while (1)
            ; // do nothing
    }

    // auto cfg = i2s.defaultConfig();
    // cfg.pin_bck = 14;
    // cfg.pin_ws = 15;
    // cfg.pin_data = 22;
    // i2s.begin(cfg);

    // 1. 关 SSP，强制走 Legacy PIN（PC 才会弹密码框）
    esp_bluedroid_config_t bluedroid_cfg = {};
    bluedroid_cfg.ssp_en = false; // 关键！关掉 SSP
    a2dp_sink.set_bluedroid_config_t(bluedroid_cfg);

    a2dp_sink.set_on_data_received(on_data);
    a2dp_sink.set_stream_reader(read_data_stream);
    a2dp_sink.set_avrc_metadata_callback(avrc_metadata_callback);
    a2dp_sink.set_avrc_rn_volumechange(on_volume_change);

    // ★ 恢复上次音量，如果没有存过默认给个 80/127
    uint8_t last_vol = prefs.getUChar("vol", 20);
    a2dp_sink.set_volume(last_vol);
    printf("Restored volume: %d\r\n", last_vol);

    a2dp_sink.start("MyMusic", true);

    // ★★★ 关键步骤：start之后立刻修改底层安全参数 ★★★
    // 这样才能让 PC 弹出输入密码框
    // 3. start() 之后立即覆盖库那次无效的 set_pin
    //    库走了 IOCAP_NONE + PIN_TYPE_FIXED + len=0，我们重新设
    esp_bt_io_cap_t iocap = ESP_BT_IO_CAP_IO; // 让 PC 弹框
    esp_bt_gap_set_security_param(ESP_BT_SP_IOCAP_MODE, &iocap, sizeof(uint8_t));

    esp_bt_pin_type_t pin_type = ESP_BT_PIN_TYPE_FIXED;
    esp_bt_pin_code_t pin_code;
    memset(pin_code, 0, sizeof(pin_code));
    const char *pwd = "1234";
    memcpy(pin_code, pwd, strlen(pwd));
    esp_bt_gap_set_pin(pin_type, strlen(pwd), pin_code); // ← len=4，这次真生效

    printf("BT Start complete. Waiting for connection...\n");
}

void loop()
{
    // 1. 超时关机检测
    if (millis() > shutdown_ms)
    {
        Serial.println("Shutting down due to inactivity");
        FastLED.clear();
        FastLED.show();
        esp_deep_sleep_start();
    }

    // 2. 连接状态打印
    esp_a2d_connection_state_t state = a2dp_sink.get_connection_state();
    if (last_state != state)
    {
        bool is_connected = (state == ESP_A2D_CONNECTION_STATE_CONNECTED);
        Serial.printf("%s\n", is_connected ? "Connected" : "Not connected");
        last_state = state;
        if (!is_connected)
        {
            // 断开时熄灭所有 LED
            FastLED.clear();
            FastLED.show();
        }
    }
    // 3. 如果有音频数据，执行 FFT 并更新 LED
    if (state == ESP_A2D_CONNECTION_STATE_CONNECTED)
    {
        performFFTAndUpdateLEDs();
    }

    delay(1);
}